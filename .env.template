# ============================================
# LLM服务配置（必需至少配置一种）
# ============================================

# DeepSeek API Key（推荐，文本生成服务）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# # Coze API Key（优先使用，功能最全）
# # 获取方式：访问 https://www.coze.cn/ 获取 API Key
# COZE_WORKLOAD_IDENTITY_API_KEY=your_coze_api_key_here

# 通义千问 API Key（文本生成fallback时使用）
# 获取方式：访问 https://dashscope.aliyun.com/ 获取 API Key
# 可以从以下两个环境变量中选择一个配置
DASHSCOPE_API_KEY=your_deepseek_api_key_here
# 或使用别名
QWEN_API_KEY=your_qwen_api_key_here

# 豆包 API Key（图片生成fallback时使用）
# 获取方式：访问 https://www.doubao.com/ 获取 API Key
DOUBAO_API_KEY=your_doubao_api_key_here

# ============================================
# 数据库配置（可选）
# ============================================
# PostgreSQL 数据库连接字符串
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ============================================
# AWS S3配置（可选，用于图片存储）
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ============================================
# Next.js配置（可选）
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:5000

# ============================================
# 环境配置（可选）
# ============================================
# 可选值：development, production, test
NODE_ENV=development


